# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# Chave da Gemini API (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Caminho da pasta do modpack (a que contém "mods" e "config")
MODPACK_PATH=C:\caminho\para\o\modpack

# Token do bot de Discord (Etapa 3)
DISCORD_TOKEN=
